a siempre se moldeará según sus propias n"]],"language":["TEXT",0.0,"10^1",["AAAAAAA","AAAAAA","AAAAAAAA"],["Japanese","French","German","Italian","Spanish","Portuguese (Brazil)","Chinese Simplified","Russian","Chinese Traditional","Korean"]],"multiverseid":["INTEGER",1.0,0,[null,null,null],[]],"name":["TEXT",0.971,"10^2",["AAAA","AAAAAAAAA","AA"],null],"text":["TEXT",0.808,"10^2",["","AA","AAAAAAAA"],null],"type":["TEXT",0.005,"10^3",["","AA","AAAAAAA"],null],"uuid":["TEXT",0.745,"10^3",["9999A9AA-A999-9A99-AA99-999AA99999AA","9A9A9A99-A999-999A-99A9-A9999AA99999","A9A9999A-99A9-9999-9A99-999A9AAA9AA9"],null]},"legalities":{"id":["INTEGER",0.0,"10^5",[100000.0,200000.0,200000.0],null],"format":["TEXT",0.0,"10^1",["AAAAAA","AAAAAAAAA","AAAAAAA"],["legacy","vintage","commander","duel","modern","penny","pauper","pioneer","premodern","gladiator","historic","standard","brawl","future","oldschool"]],"status":["TEXT",0.0,"10^0",["AAAAA","AAAAAA","AAAAAAAAAA"],["Legal","Banned","Restricted"]],"uuid":["TEXT",0.0,"10^4",["99999AA9-9A99-9A99-A9A9-99A99A99A99A","999AA99A-9A9A-99AA-9A99-9A99AAAAAA9A","99999999-9A99-9A99-999A-AA9A99A999AA"],null]},"rulings":{"id":["INTEGER",0.0,"10^4",[20000.0,20000.0,50000.0],null],"date":["DATE",0.001,"10^2",["YYYY-MM-DD"],null],"text":["TEXT",0.448,"10^3",["AAAAAAA_AA_AA_AAAAAAAAA_AAAAAAA._AAAAAAA_AAAA_AAAAAAAA_AAAA_AAAAAAAAA_AAAAAAAAA_…","AA_AA_AAAAAA_AAAAAA_AA_AAAAAAAAA_AAAAA?_AAAA_AAAA_AA_AAAAAA_AA_AA_AAAAAAAA._AA_A…","AA_AA_AAAAAAAAAA_AAAA_AAAA_AA_AA_AAAAA_AAA_AAA_AAAAA_AAAAAA_AAAA_AA_AAAAAAA_AAAA…"],null],"uuid":["TEXT",0.702,"10^3",["999A99A9-9A99-9A99-99AA-99AA999999A9","A9AA9A9A-AA99-9999-9A99-A9AA99A9AA9A","99A99AA9-AAAA-9999-9AA9-99AA9AA9A9AA"],null]},"set_translations":{"id":["INTEGER",0.0,"10^3",[200.0,500.0,500.0],null],"language":["TEXT",0.0,"10^1",["AAAAAA","AAAAAAA","AAAAAAAA"],["French","Spanish","German","Italian","Japanese","Chinese Simplified","Korean","Russian","Portuguese (Brazil)","Chinese Traditional"]],"setCode":["TEX